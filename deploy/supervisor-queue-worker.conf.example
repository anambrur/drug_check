; Supervisor config for Laravel queue worker (collection site imports).
; Copy to /etc/supervisor/conf.d/mydrugchecklive-worker.conf on the server,
; then run: sudo supervisorctl reread && sudo supervisorctl update && sudo supervisorctl start mydrugchecklive-worker:*

[program:mydrugchecklive-worker]
process_name=%(program_name)s_%(process_num)02d
command=php /path/to/mydrugchecklive/artisan queue:work database --sleep=3 --tries=1 --timeout=3600 --max-time=3600
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/path/to/mydrugchecklive/storage/logs/worker.log
stopwaitsecs=3600
